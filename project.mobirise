          },
          "_name": "pricing02",
          "_sourceTheme": "agentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing2 agentm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Secondary Color\" value=\"#009472\" name=\"title\" condition=\"showTitle\" selected>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"color\" title=\"Description Border\" value=\"#cfcfcf\" name=\"border\" selected>\n        <input type=\"color\" title=\"Container BG\" value=\"#ffffff\" name=\"container\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showCardDesc\" checked>\n        <input type=\"color\" title=\"Description BG\" value=\"#009472\" name=\"desc\" condition=\"showCardDesc\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Card BG\" value=\"#ffffff\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-3 card\">\n                <div class=\"desc-wrapper\" mbr-if=\"showDesc\">\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-desc, .desc-wrapper\">Pricing</p>\n                </div>\n            </div>\n<div class=\"col-12 card\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b><span>השירותים</span>&nbsp;שלי</b></h2>\n                </div>\n            </div>\n            <div class=\"col-12 card\">\n                <div class=\"cards-wrapper\">\n                    <div class=\"item features-image item-mb active\">\n                        <div class=\"item-desc\" mbr-if=\"showCardDesc\">\n                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc, .item-desc\" mbr-theme-style=\"display-4\">דף נחיתה/אתרון</p>\n                        </div>\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-content\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/bg4.jpg\" alt=\"עמית שכטר בניית אתרים\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                                </div>\n                                <p class=\"card-price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-price\">אתר עד 2 דפים&nbsp;</p>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">אתר עד 2 דפים – 1000–1500 ש\"ח בלבד<br>אתר בסיסי ומעוצב אישית במחיר משתלם במיוחד<br>זמן הכנה: 1–2 שבועות בהתאמה אישית מלאה<br></p>\n                            </div>\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"התהליך והמחיר.html#pricing01-d\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mbr-iconfont mbr-iconfont-btn\"></span>לעוד פרטים</a></div>\n                        </div>\n                    </div><div class=\"item features-image item-mb\">\n                        <div class=\"item-desc\" mbr-if=\"showCardDesc\">\n                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc, .item-desc\" mbr-theme-style=\"display-4\">אתר עד 8 דפים&nbsp;</p>\n                        </div>\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-content\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/bg4.jpg\" alt=\"עמית שכטר בניית אתרים\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                </div>\n                                <p class=\"card-price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-price\">אתר עד 8 דפים&nbsp;</p>\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn, .icon-wrapper\">Contract\n                                    Staffing</h4>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">אתר עד 8 דפים – 2700–4500 ש\"ח בלבד<br>אתר רחב, מעוצב ומדויק לצרכים של העסק שלך<br>זמן הכנה: 4–6 שבועות לפי דרישות הלקוח<br></p>\n                            </div>\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"התהליך והמחיר.html#pricing01-d\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>לעוד פרטים\n                            </a></div>\n                        </div>\n                    </div>\n                    \n                    <div class=\"item features-image item-mb\">\n                        <div class=\"item-desc\" mbr-if=\"showCardDesc\">\n                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc, .item-desc\" mbr-theme-style=\"display-4\">אתר תדמית</p>\n                        </div>\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-content\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/bg4.jpg\" alt=\"בניית אתר תדמית\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                </div>\n                                <p class=\"card-price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-price\">אתר עד 5 דפים</p>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">אתר עד 5 דפים – 1800–2700 ש\"ח בלבד<br>אתר מקצועי בעיצוב מותאם לצרכים שלך<br>זמן הכנה: 2–4 שבועות בהתאם לתיאום<br></p>\n                            </div>\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"התהליך והמחיר.html#pricing01-d\" data-app-placeholder=\"Type Text\">\n                                    <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                    לעוד פרטים\n                                </a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n    </div>\n</section>",
          "_cid": "uOmVhxqrrL",
