        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "#fff",
              "background-image": "radial-gradient(circle at bottom right, rgba(0, 119, 92, 0.12) 0%, transparent 60%)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".container": {
              "padding-left": "10px",
              "padding-right": "10px"
            },
            ".row": {
              "margin-left": "-10px",
              "margin-right": "-10px",
              "justify-content": "center",
              "> [class*=\"col\"]": {
                "padding-left": "10px",
                "padding-right": "10px"
              }
            },
            ".col-text": {
              "display": "flex",
              "align-items": "center",
              "padding": "10px",
              "@media (max-width: 991px)": {
                "order": "2",
                "margin-top": "20px"
              }
            },
            ".text-wrapper": {
              "width": "100%",
              "@media (min-width: 992px)": {
                "& when not (@reverseContent)": {
                  "padding-left": "50px"
                },
                "& when (@reverseContent)": {
                  "padding-right": "50px"
                }
              },
              "@media (max-width: 991px)": {
                "padding": "10px"
              }
            },
            ".mbr-section-title": {
              "color": "#00775c",
              "margin-bottom": "15px",
              "@media (max-width: 575px)": {
                "margin-bottom": "0",
                "text-align": "center !important"
              },
              "text-align": "right"
            },
            ".mbr-section-subtitle": {
              "color": "#000001",
              "margin-bottom": "20px",
              "@media (max-width: 575px)": {
                "text-align": "center !important"
              },
              "text-align": "right"
            },
            ".mbr-text": {
              "color": "#C4CFDE",
              "margin-bottom": "20px",
              "padding-right": "80px",
              "@media (max-width: 991px)": {
                "padding-right": "0"
              }
            },
            ".mbr-section-btn": {
              "margin-top": "10px"
            },
            ".list-container": {
              "margin-bottom": "30px",
              "@media (max-width: 575px)": {
                "margin-bottom": "20px"
              }
            },
            ".list-item": {
              "display": "flex",
              "align-items": "center",
              "width": "100%",
              "padding": "10px 0 "
            },
            ".iconfont-wrapper": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "flex-start",
              "margin-right": "15px",
              ".mbr-iconfont": {
                "font-size": "18px",
                "color": "@iconColor"
              }
            },
            ".list-item-text": {
              "color": "#C4CFDE",
              "width": "fit-content",
              "text-align": "left"
            },
            ".col-img": {
              "display": "flex",
              "align-items": "center",
              "padding": "10px",
              "@media (max-width: 991px)": {
                "order": "1"
              }
            },
            ".image-wrapper": {
              "position": "relative",
              "width": "100%",
              "img": {
                "position": "relative",
                "z-index": "5",
                "object-fit": "cover",
                "width": "80%"
              }
            },
            ".img-bg": {
              "content": "\"\"",
              "position": "absolute",
              "z-index": "4",
              "width": "100%",
              "height": "~\"calc(100% - 130px)\"",
              "left": "0",
              "bottom": "0",
              "background": "linear-gradient(145deg, @cardBg1, @cardBg2)",
              "& when (@cardShadow)": {
                "box-shadow": "10px 10px 19px @shadowColor1, -10px -10px 19px @shadowColor2"
              },
              "border-radius": "6px"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "right",
              "color": "#000000"
            }
          },
          "_name": "aheader2",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header2 expertm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" condition=\"showList\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#C4CFDE\" condition=\"showIcon && showList\">\n        <input type=\"range\" inline title=\"List 1 Count\" name=\"list1Count\" min=\"1\" max=\"6\" step=\"1\" value=\"3\" condition=\"showList\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Image</header>\n        <input type=\"checkbox\" name=\"imgBg\" title=\"Image BG\">\n        <input type=\"color\" title=\"Image BG 1\" name=\"cardBg1\" value=\"#ffffff\" condition=\"imgBg\">\n        <input type=\"color\" title=\"Image BG 2\" name=\"cardBg2\" value=\"#f5f5f5\" condition=\"imgBg\">\n        <input type=\"checkbox\" name=\"cardShadow\" title=\"Image Shadow\" condition=\"imgBg\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"shadowColor1\" value=\"#191b1f\" condition=\"cardShadow && imgBg\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"shadowColor2\" value=\"#23272B\" condition=\"cardShadow && imgBg\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background2.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#e6e6e6\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center align-items-stretch\">\n            <div class=\"col-12 col-lg-5 col-img\">\n                <div class=\"image-wrapper\">\n                    <div class=\"img-bg\" mbr-if=\"imgBg\"></div>\n                    <img src=\"@PROJECT_PATH@/assets/images/-whatsapp-2025-01-19-18.20.23-180a0c70-640x640-removebg-preview-1-500x500.png\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-7 col-text\">\n                <div class=\"text-wrapper\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">עמית שכטר</h1>\n                    <h1 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-1\" mbr-if=\"showSubtitle\"><b>&nbsp; פיתוח אתרי תדמית</b></h1>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b>קצת עליי\n<br>אני בן 16, תלמיד במקיף אמי\"ת בבאר שבע, לומד במגמת מדעי המחשב\n<br>במקביל ללימודים, אני משתתף בשתי תוכניות מצוינות ארציות\n<br>\n<br>\"מגשימים\" – תוכנית לאומית להכשרת בני נוער בתחום הסייבר\n<br>\n<br>תוכנית ממר\"ם – מסלול הכשרה יוקרתי ללימודי תכנות ומערכות מחשוב\n<br>\n<br>במהלך שלוש השנים האחרונות רכשתי ניסיון מעשי בשפות תכנות וטכנולוגיות רבות, ביניהן\n<br>C, Python, Java, JavaScript, HTML, CSS, SQL\n<br>\n<br>אני מתמחה בבניית אתרי תדמית רספונסיביים, מעוצבים ומותאמים אישית, שמדגישים את הייחודיות והמקצועיות של העסק שלך\n<br>המטרה שלי היא ליצור עבורך נוכחות דיגיטלית מרשימה שתמשוך לקוחות ותמנף את העסק שלך קדימה</b></p>\n                    <div class=\"list-container\" mbr-if=\"showList\">\n                        <div class=\"list-item\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                            </div>\n                            <p class=\"list-item-text mbr-fonts-style mb-0\" data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                Web Design Full stack\n                            </p>\n                        </div>\n                        <div class=\"list-item\" mbr-if=\"list1Count > 1\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                            </div>\n                            <p class=\"list-item-text mbr-fonts-style mb-0\" data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                24/7 Support\n                            </p>\n                        </div>\n                        <div class=\"list-item\" mbr-if=\"list1Count > 2\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                            </div>\n                            <p class=\"list-item-text mbr-fonts-style mb-0\" data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                Unlimited Revisions\n                            </p>\n                        </div>\n                        <div class=\"list-item\" mbr-if=\"list1Count > 3\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                            </div>\n                            <p class=\"list-item-text mbr-fonts-style mb-0\" data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                Pellentesque habitant\n                            </p>\n                        </div>\n                        <div class=\"list-item\" mbr-if=\"list1Count > 4\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                            </div>\n                            <p class=\"list-item-text mbr-fonts-style mb-0\" data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                Tellus elementum sagittis\n                            </p>\n                        </div>\n                        <div class=\"list-item\" mbr-if=\"list1Count > 5\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                            </div>\n                            <p class=\"list-item-text mbr-fonts-style mb-0\" data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                Vitae proin sagittis\n                            </p>\n                        </div>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">דברו איתי<br></a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uOmQ5hDXUA",
          "_anchor": "aheader2-t",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "features1",
          "_sourceTheme": "mobirise5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "#fff",
              "background-image": "radial-gradient(circle at top right, rgba(0, 119, 92, 0.12) 0%, transparent 60%), radial-gradient(circle at bottom left, rgba(0, 119, 92, 0.12) 0%, transparent 60%)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "@media (min-width: 1500px)": {
              ".container": {
                "max-width": "1400px"
              }
            },
            ".mbr-iconfont": {
              "display": "block",
              "font-size": "5rem",
              "color": "@iconColor",
              "margin-bottom": "2rem"
            },
            ".card-wrapper": {
              "margin-top": "3rem"
            },
            ".row": {
              "justify-content": "center"
            },
            ".card-title, .iconfont-wrapper": {
              "color": "#000000"
            },
            ".card-text": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "color": "#00775c"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"9\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#4479d9\" selected condition=\"showIcon\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background4.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showMainTitle || showMainSubtitle\" mbr-class=\"{'col-lg-9': cardsAmount == '3'}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                    <b>?למה אצלי</b></h3>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                    List main features of your project in this block\n                </h5>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"card col-12 col-md-6 col-lg-3\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-center\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-laptop mobi-mbri\" style=\"color: rgb(0, 119, 92); fill: rgb(0, 119, 92);\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>איכות ומקצועיות</b></h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">היכולת שלי להתאים את העיצוב והפונקציות של האתר בדיוק לדרישות הייחודיות שלך, מבטיחה לך חוויה אישית, איכותית ומקצועית. אני מציע זמינות גבוהה ומחוייב לתת מענה מהיר&nbsp; כולל ביצוע שינויים ושדרוגים בזמן אמת<br>המטרה שלי היא לספק לך את הכלים, התמיכה והליווי המקצועיים שיאפשרו לעסק שלך לגדול ולהצליח בעולם הדיגיטלי</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-3\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-center\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mbri-user\" style=\"color: rgb(0, 119, 92); fill: rgb(0, 119, 92);\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>אישיות&nbsp;</b></h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">אני לא רק בונה אתרים — אני שותף לדרך שלך<br>עם גישה אישית, סבלנות ומסירות, אני מקשיב לצרכים שלך ויוצר פתרונות מדויקים שמתאימים בדיוק לך<br>אני מאמין בתקשורת פתוחה וזמינות גבוהה, כדי שתוכל להרגיש בטוח ורגוע לאורך כל התהליך<br>המחויבות שלי היא לספק לך שירות אמין, מקצועי ואיכותי, וללוות אותך בכל שלב — גם אחרי שהאתר עלה לאוויר</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-3\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-center\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-users mobi-mbri\" style=\"color: rgb(0, 119, 92); fill: rgb(0, 119, 92);\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>חיבור אישי עם הלקוח</b></h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">עד שאתה לא מרוצה — אני לא מרוצה<br>אני אעשה כל שביכולתי כדי שהמוצר שתקבל יהיה בדיוק כפי שחלמת, גם אם זה אומר לדחות מעט את סיום הפרויקט כדי להבטיח איכות ושביעות רצון מלאה שלך<br>המטרה שלי היא לא רק לבנות אתר, אלא ליצור עבורך פתרון מושלם שילווה אותך בהצלחה לאורך זמן</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-3\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-center\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mbri-flag\" style=\"color: rgb(0, 119, 92); fill: rgb(0, 119, 92);\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>המחיר</b></h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">אני מציע מחירים נגישים ותחרותיים, בהתחשב באיכות הגבוהה של המוצרים והשירותים שאני מספק<br>אני מתחייב לתת לך ערך מוסף אמיתי ותוצאות מצוינות, במחיר ההוגן והטוב ביותר שאוכל להציע<br>המטרה שלי היא להבטיח שתקבל שירות מקצועי ואיכותי, שמתאים בדיוק לתקציב שלך, בלי לוותר על האיכות והדיוק<br></p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "features1-1",
          "_isUserblock": true,
          "_cid": "tXM52Fa8f5",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "#fff",
              "background-image": "radial-gradient(circle at top left, rgba(0, 119, 92, 0.12) 0%, transparent 60%), radial-gradient(circle at bottom right, rgba(0, 119, 92, 0.12) 0%, transparent 60%)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#000000"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "margin": "0",
              "border-radius": "20px",
              "padding": "150px",
              "@media (max-width: 1440px)": {
                "padding": "150px 32px"
              },
              "@media (max-width: 1200px)": {
                "padding": "150px 8px"
              },
              "@media (max-width: 992px)": {
                "padding": "70px 60px"
              },
              "@media (max-width: 768px)": {
                "padding": "70px 16px"
              },
              ".card": {
                "padding": "0",
                "border-radius": "0 !important",
                "overflow": "visible"
              }
            },
            ".desc-wrapper": {
              "padding-right": "32px",
              "margin-bottom": "64px",
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              "& when (@reverseContent)": {
                "padding-right": "0",
                "padding-left": "32px",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              ".mbr-desc": {
                "padding": "10px 18px",
                "display": "inline-flex",
                "border": "1px solid @border",
                "border-radius": "30px",
                "margin-bottom": "0"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "64px",
              "span": {
                "color": "@title"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".cards-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr",
              "column-gap": "24px",
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".item": {
                "position": "relative",
                "margin": "50px 0 40px 0",
                "@media (max-width: 992px)": {
                  "margin": "50px 0 100px 0"
                },
                "& when (@showCardDesc)": {
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "width": "100%",
                    "height": "50%",
                    "background-color": "@desc",
                    "border-radius": "16px 16px 0 0",
                    "transition": "all 0.3s ease-in-out"
                  }
                },
                ".item-desc": {
                  "position": "absolute",
                  "width": "100%",
                  "top": "-47px",
                  "left": "0",
                  "transition": "all 0.3s ease-in-out",
                  ".card-desc": {
                    "display": "inline-block",
                    "min-width": "250px",
                    "padding": "15px 22px 30px",
                    "border-radius": "16px 16px 0 0",
                    "background-color": "@desc",
                    "@media (max-width: 992px)": {
                      "min-width": "auto"
                    }
                  }
                },
                "&:hover, &:focus": {
                  ".item-wrapper .item-img img": {
                    "transform": "scale(1.05)"
                  },
                  "& when (@showCardDesc)": {
                    "&::before": {
                      "top": "-10px"
                    }
                  },
                  ".item-desc": {
                    "top": "-57px"
                  }
                },
                ".item-wrapper": {
                  "padding": "40px",
                  "border-radius": "16px !important",
                  "background-color": "@card",
                  "position": "relative",
                  "z-index": "1",
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "height": "100%",
                  "@media (max-width: 992px)": {
                    "padding": "22px"
                  },
