        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "#fff",
              "background-image": "radial-gradient(circle at top left, rgba(0, 119, 92, 0.12) 0%, transparent 60%), radial-gradient(circle at bottom right, rgba(0, 119, 92, 0.12) 0%, transparent 60%)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 20px",
                "@media (max-width: 992px)": {
                  "padding": "0 6px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 6px"
              }
            },
            ".row-main": {
              "margin": "0",
              "padding": "0 150px",
              "justify-content": "center",
              "@media (max-width: 1440px)": {
                "padding": "0 32px"
              },
              "@media (max-width: 1200px)": {
                "padding": "0 8px"
              },
              "@media (max-width: 992px)": {
                "padding": "0 60px"
              },
              "@media (max-width: 768px)": {
                "padding": "0 30px"
              },
              ".card": {
                "padding": "0",
                "border-radius": "0 !important",
                "overflow": "visible"
              }
            },
            ".form-wrap": {
              "padding": "40px 45px ",
              "background-color": "@form",
              "border-radius": "10px",
              "@media (max-width: 992px)": {
                "padding": "22px"
              },
              ".dragArea.row": {
                ".mbr-section-title": {
                  "margin-bottom": "32px !important"
                },
                ".mbr-text": {
                  "margin-bottom": "32px"
                },
                ".form-group": {
                  "margin-bottom": "25px !important",
                  ".form-control": {
                    "padding": "0 20px",
                    "min-height": "60px",
                    "border": "none !important",
                    "box-shadow": "none",
                    "border-radius": "10px !important",
                    "background-color": "@input",
                    "&:hover, &:focus": {
                      "border": "none !important",
                      "box-shadow": "none"
                    },
                    "&::placeholder": {
                      "color": "@successColor"
                    }
                  },
                  "textarea": {
                    "min-height": "160px"
                  },
                  ".form-check": {
                    "padding-right": "1.7em",
                    "margin-bottom": "10px",
                    ".form-check-input": {
                      "background-color": "@secondaryColor",
                      "border-color": "@secondaryColor"
                    }
                  }
                },
                ".mbr-section-btn": {
                  ".btn": {
                    "min-height": "54px",
                    "width": "100%"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#cfcfcf",
              "text-align": "center"
            },
            "label": {
              "color": "@infoColor"
            },
            "LABEL": {
              "text-align": "right"
            },
            "P": {
              "color": "#00775c"
            }
          },
          "_name": "form01",
          "_sourceTheme": "agentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 agentm5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"color\" title=\"Form BG\" value=\"#262626\" name=\"form\" selected>\n        <input type=\"color\" title=\"Input BG\" value=\"#ffffff\" name=\"input\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row row-main\">\n            <div mbr-form class=\"col-12 col-lg-6 card mx-auto mbr-form\">\n<!--Formbuilder Form-->\n<form data-verified=\"amitater6630@gmail.com\" action=\"amitater6630@gmail.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler form-wrap\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">:הפרטיים נשלחו בהצלחה</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> ...תקלה לא צפויה </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-12 col-md-12 col-sm-12\">\n<h3 mbr-theme-style=\"display-5\" class=\"mbr-section-title mbr-fonts-style\"><b>דברו איתי</b></h3>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12\">\n<p mbr-theme-style=\"display-7\" class=\" mbr-text mbr-fonts-style\"><b>אני אחזור אליך בהקדם</b></p>\n</div>\n<div data-for=\"name\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n<input type=\"text\" name=\"name\" style=\"text-align:right\" placeholder=\"*שם\" data-form-field=\"name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n</div>\n<div data-for=\"email\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n<input type=\"email\" name=\"email\" placeholder=\"*אימייל\" style=\"text-align:right\" data-form-field=\"email\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n</div>\n<div data-for=\"phone\" class=\"col-12 form-group mb-3\">\n<input type=\"tel\" name=\"phone\" placeholder=\"*מספר טלפון\" style=\"text-align:right\" data-form-field=\"phone\" mbr-theme-style=\"display-7\" class=\"form-control \" value>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 mbr-section-btn\" style mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 w-100 btn btn-secondary\">שלח</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "form01-0",
          "_isUserblock": true,
          "_cid": "tXLYasR9bV",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "#fff",
              "background-image": "radial-gradient(circle at top right, rgba(0, 119, 92, 0.12) 0%, transparent 60%), radial-gradient(circle at bottom left, rgba(0, 119, 92, 0.12) 0%, transparent 60%)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 20px",
                "@media (max-width: 992px)": {
                  "padding": "0 6px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 6px"
              }
            },
            ".row": {
              "margin": "0",
              "padding": "150px",
              "@media (max-width: 1440px)": {
                "padding": "150px 32px"
              },
              "@media (max-width: 1200px)": {
                "padding": "150px 8px"
              },
              "@media (max-width: 992px)": {
                "padding": "70px 60px"
              },
              "@media (max-width: 768px)": {
                "padding": "70px 30px"
              },
              ".card": {
                "padding": "0",
                "border-radius": "0 !important",
                "overflow": "visible"
              }
            },
            ".desc-wrapper": {
              "padding-right": "32px",
              "margin-bottom": "64px",
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              "& when (@reverseContent)": {
                "padding-right": "0",
                "padding-left": "32px",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              ".mbr-desc": {
                "padding": "10px 18px",
                "display": "inline-flex",
                "border": "1px solid @border",
                "border-radius": "30px",
                "margin-bottom": "0"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "64px",
              "span": {
                "color": "@title"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".cards-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr",
              "gap": "50px 40px",
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".item": {
                "position": "relative",
                "margin-top": "50px",
                "@media (max-width: 992px)": {
                  "margin": "50px 0 100px 0"
                },
                ".item-wrapper": {
                  "padding": "0 30px 30px",
                  "border-radius": "16px !important",
                  "background-color": "@card",
                  "@media (max-width: 992px)": {
                    "padding": "0 22px 22px"
                  },
                  ".item-img": {
                    "margin-bottom": "20px",
                    "position": "relative",
                    "display": "flex",
                    "justify-content": "center",
                    "height": "50px",
                    "img": {
                      "position": "absolute",
                      "top": "-50px",
                      "height": "100px",
                      "width": "100px",
                      "object-fit": "cover",
                      "border-radius": "100% !important",
                      "border": "10px solid @image"
                    }
                  },
                  ".item-content": {
                    ".card-title": {
                      "margin-bottom": "10px"
                    },
                    ".card-desc": {
                      "margin-bottom": "10px"
                    },
                    ".mbr-text": {
                      "margin-bottom": "0"
                    },
                    ".mbr-section-btn": {
                      "margin-top": "20px",
                      ".btn": {
                        "border": "none",
                        "text-decoration": "underline"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-desc": {
              "color": "#262626"
            },
            ".mbr-section-title": {
              "color": "#131313",
              "text-align": "center"
            },
            ".card-desc": {
              "color": "#009472",
              "text-align": "center"
            },
            ".card-title": {
              "color": "#131313"
            },
            ".card-text": {
              "color": "#131313",
              "text-align": "center"
            },
            ".card-title, .mbr-section-btn": {
              "text-align": "center"
            }
          },
          "_name": "features07",
          "_sourceTheme": "agentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features07 agentm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Secondary Color\" value=\"#009472\" name=\"title\" condition=\"showTitle\" selected>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"color\" title=\"Description Border\" value=\"#cfcfcf\" name=\"border\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showCardDesc\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Image Border\" value=\"#009472\" name=\"image\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#ffffff\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#e6e6e6\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-3 card\">\n                <div class=\"desc-wrapper\" mbr-if=\"showDesc\">\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-desc, .desc-wrapper\">\n                        Comments\n                    </p>\n                </div>\n            </div>\n<div class=\"col-12 card\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b><span>&nbsp;לקוחות מרוצים</span><br>&nbsp;ממליצים</b></h2>\n                </div>\n            </div>\n            <div class=\"col-12 card\">\n                <div class=\"cards-wrapper\">\n                    <div class=\"item features-image item-mb active\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/whatsapp-2025-04-01-18.01.16-11165bd6.jpg-1-160x90.jpeg\" alt=\"Mobirise\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                            </div>\n                            <div class=\"item-content\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\"><b>עוף בגריל בביג</b></h4>\n                                <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDesc\" data-app-selector=\".card-desc\"><b>רשת חנויות עוף בגריל</b></p>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">!תודה רבה</p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"https://ofbagrilbabig.com/\" data-app-placeholder=\"Type Text\" target=\"_blank\">ofbagrilbabig.com</a></div>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/-whatsapp-2024-10-29-19.26.20-0ce8991b-747x657.jpg\" alt=\"Mobirise\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                            </div>\n                            <div class=\"item-content\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\"><b>רפאלוס אינסטלציה</b></h4>\n                                <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDesc\" data-app-selector=\".card-desc\"><b>אינסטלטור במרכז הארץ ובדרום</b></p>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">עמית היקר תודה רבה על שירות אדיב טוב נדיב&nbsp;<br>שאמרת לי בהתחלה שאתה לוקח מחירים נוחים חשבתי שזה&nbsp;<br>יפגע באיכות של האתר אבל טעייתי בגדול תודה רבה על הכול עמית&nbsp;<br>מעריך מאוד בהצלחה ממליץ בחום לבאים בתור</p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"https://refaelos-plumbing.com/\" data-app-placeholder=\"Type Text\" target=\"_blank\">refaelos-plumbing.com</a></div>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/-whatsapp-2024-08-06-22.04.18-f933bf3a-653x583.jpg\" alt=\"Mobirise\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                            </div>\n                            <div class=\"item-content\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\"><b>הנגריה</b></h4>\n                                <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDesc\" data-app-selector=\".card-desc\">אולם אירועים בכרמיאל<br></p>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">ממליצים בחום עמית נתן לנו תפריט מדהים שאין בכל אתר<br>עם הרבה השקעה ועבודה אחרי זה גם רכשנו שירותי תחזוקה&nbsp;<br>והשינוים שהוא מוסיף ומשנה נותנים המון לאתר וכל פעם מתקן בעיות תקלות ודברים שאפשר לעשות טוב יותר הוא עושה&nbsp;<br>פשוט תודה&nbsp;</p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"https://hanagrya.com/\" data-app-placeholder=\"Type Text\" target=\"_blank\">hanagrya.com</a></div>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/-723x577.jpg\" alt=\"Mobirise\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                            </div>\n                            <div class=\"item-content\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\"><b>הדר ניזרית</b></h4>\n                                <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDesc\" data-app-selector=\".card-desc\">מרכז למידה מא עד ת&nbsp;<br></p>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">עמית היקר!!!<br>ראשית אפתח בתודה ענקית על בניית אתר מושלם,<br>אבל מה שחשוב יותר מהתוצאה זו הדרך.<br>תודה על דרך מקצועית,סבלנית ואיכותית לאורך כל התהליך,<br>!אתה פשוט תותח<br>פחות מ24 שעות שהאתר באויר, והמחמאות לא פוסקות.<br>,מי שמתלבט חבל לכם על זמן יקר<br>???צריכים אתר<br>.רק עמית שכטר בע\"מ<br>מעריכה&nbsp;מאוד🙏🏻,&nbsp;הדר&nbsp;<br></p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"https://merkaz-lamida-a-t.com/\" data-app-placeholder=\"Type Text\" target=\"_blank\">merkaz-lamida-a-t.com</a></div>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/-whatsapp-2024-04-18-11.13.13-0d45a548-499x549.jpg\" alt=\"Mobirise\" data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                            </div>\n                            <div class=\"item-content\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\"><b>מני ראובן</b></h4>\n                                <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDesc\" data-app-selector=\".card-desc\">בית ספר לכדורגל<br></p>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">תודה רבה נהניתי מהשירות שלך ובנוסף העלות של&nbsp;<br>האתר זה באמת בדיחה בשביל מה שקיבלתי&nbsp;<br>אני מאושר על כל רגע שבניתי אצלך&nbsp;<br>ממליץ בחום&nbsp;<br>ואפרסם אותך המון למה שירות כזה לא<br>ראיתי בחיים</p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"http://gollasso.com\" data-app-placeholder=\"Type Text\" target=\"_blank\">gollasso.com</a></div>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/e7d3a3cc-ea1c-4f03-9432-c7e451ba0361-2-160x165.jpg\" alt=\"Mobirise\" data-slide-to=\"5\" data-bs-slide-to=\"5\">\n                            </div>\n                            <div class=\"item-content\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\">\n                                    <b>אפרת שכטר</b></h4>\n                                <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDesc\" data-app-selector=\".card-desc\">\n                                    <b>בניית אתר לטיפול רגשי</b></p>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">עמית היקר תודה רבה על האתר ועל התחזוקה של האתר מעריכה מאוד איכותי ומשתלם&nbsp;<br>ממליצה בחום לכל מי שרוצה לבנות אתר לעסק&nbsp;<br>שלו הכי טוב בתחום מבחינת שירות ומקצועיות<br>והבונוס גם מעצב ממש יפה<br>תודה רבה על הכול</p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"http://efratshechternlp.com\" data-app-placeholder=\"Type Text\" target=\"_blank\">efratshechternlp.com</a></div>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/1015x998.jpg\" alt=\"Mobirise\" data-slide-to=\"6\" data-bs-slide-to=\"6\">\n                            </div>\n                            <div class=\"item-content\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\"><b>נאני דגים</b></h4>\n                                <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDesc\" data-app-selector=\".card-desc\"><b>חנות מקוונת של דגים&nbsp; במשלוח חינם עד לבית</b></p>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\"><br>תודה רבה רבה עמית נתת מעל ומעבר אחי<br>באמת עשית דברים שלא היית צריך לעשות&nbsp;<br>באמת שמח על כל רגע שבחרתי לעשות אצלך אתר אחי לא נראה לי שאפשר לקבל יותר תמורה במחירים האלו<br>תודה רבה מעריך מאוד</p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"https://nanidagim.com/\" data-app-placeholder=\"Type Text\" target=\"_blank\">nanidagim.com</a></div>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/def0c2b9-26b4-49ab-b3f7-7778f584f647-3-160x285.jpeg\" alt=\"Mobirise\" data-slide-to=\"7\" data-bs-slide-to=\"7\">\n                            </div>\n                            <div class=\"item-content\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\"><b>בוריס איפרהימוב</b></h4>\n                                <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDesc\" data-app-selector=\".card-desc\"><b>גנן באזור השרון</b></p>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">תודה רבה על השירות המעולה גם עם הלוגו וגם עם העזרה הכללית במהלך בניית האתר והמחיר מאוד משתלם ביחס למה שקיבלת ממליץ בחום <br>לכולם היה לי חוויה לעבוד איתך עמית תודה רבה<br>בוריס בגינה<br><br></p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"https://borisbagina.com/\" data-app-placeholder=\"Type Text\">borisbagina.com</a></div>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    \n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "features07-o",
          "_isUserblock": true,
          "_cid": "u388fJxgUM",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "#fff",
              "background-image": "radial-gradient(circle at top left, rgba(0, 119, 92, 0.12) 0%, transparent 60%), radial-gradient(circle at bottom right, rgba(0, 119, 92, 0.12) 0%, transparent 60%)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 20px",
                "@media (max-width: 992px)": {
                  "padding": "0 6px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 6px"
              }
            },
            ".row": {
              "margin": "0",
              "padding": "150px",
              "@media (max-width: 1440px)": {
                "padding": "150px 32px"
              },
              "@media (max-width: 1200px)": {
                "padding": "150px 8px"
              },
              "@media (max-width: 992px)": {
                "padding": "70px 60px"
              },
              "@media (max-width: 768px)": {
                "padding": "70px 30px"
              },
              ".card": {
                "padding": "0",
                "border-radius": "0 !important",
                "overflow": "visible"
              }
            },
            ".desc-wrapper": {
              "padding-right": "32px",
              "margin-bottom": "64px",
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              "& when (@reverseContent)": {
                "padding-right": "0",
                "padding-left": "32px",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              ".mbr-desc": {
                "padding": "10px 18px",
                "display": "inline-flex",
                "border": "1px solid @border",
                "border-radius": "30px",
                "margin-bottom": "0"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "64px",
              "& when (@showDecor)": {
                "margin-bottom": "110px"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".image-wrapper": {
              "position": "relative",
              "height": "510px",
              "@media (max-width: 992px)": {
                "margin-bottom": "64px",
                "height": "350px"
              },
              "img": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "z-index": "1",
                "height": "100%",
                "width": "100%",
                "object-fit": "cover"
              },
              ".decor-wrap": {
                "position": "relative",
                "height": "480px",
                "border-radius": "0 16px 16px 16px",
                "background-color": "@decor",
                "transform": "rotate(-3deg)",
                "margin-top": "-1rem",
                "margin-right": "1rem",
                "margin-left": "-1.5rem",
                "@media (max-width: 992px)": {
                  "height": "350px"
                },
                "&::after": {
                  "content": "''",
                  "position": "absolute",
                  "top": "-39px",
                  "left": "0",
                  "height": "40px",
                  "width": "130px",
                  "border-radius": "16px 16px 0 0",
                  "background-color": "@decor"
                }
              }
            },
            ".panel-group": {
              "margin-left": "100px",
              "& when (@reverseContent)": {
                "margin-left": "0",
                "margin-right": "100px",
                "@media (max-width: 992px)": {
                  "margin": "0"
                }
              },
              "@media (max-width: 992px)": {
                "margin": "0"
              },
              ".card": {
                "border": "none",
                "border-radius": "10px !important",
                "background-color": "@card",
                "margin-bottom": "10px",
                ".card-header": {
                  "padding": "25px 30px",
                  "border": "none",
                  "background-color": "transparent",
                  ".panel-title": {
                    "display": "flex",
                    "align-items": "right",
                    "justify-content": "space-between",
                    "&:not(.collapsed)": {
                      ".icon-wrapper": {
                        "background-color": "@active",
                        "transform": "rotate(-45deg)",
                        ".mbr-iconfont": {
                          "opacity": "1"
                        }
                      }
                    },
                    "&:hover": {
                      ".icon-wrapper": {
                        "background-color": "@active",
                        ".mbr-iconfont": {
                          "opacity": "1"
                        }
                      }
                    },
                    ".panel-title-edit": {
                      "margin-bottom": "0"
                    },
                    ".icon-wrapper": {
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "width": "40px",
                      "min-width": "40px",
                      "height": "40px",
                      "background-color": "@iconBg",
                      "margin-left": "22px",
                      "transition": "all 0.3s ease-in-out",
                      "border-radius": "100%",
                      ".mbr-iconfont": {
                        "font-size": "24px",
                        "color": "@icon",
                        "transition": "all 0.3s ease-in-out",
                        "opacity": ".5"
                      }
                    }
                  }
                },
                ".panel-collapse": {
                  ".panel-body": {
                    "padding": "0 30px 20px",
                    ".panel-text": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#00775c",
              "text-align": "right"
            },
            ".panel-title-edit": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".panel-text": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".panel-title-edit P": {
              "text-align": "center"
            }
          },
          "_name": "list01",
          "_sourceTheme": "agentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list01 agentm5\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"color\" title=\"Description Border\" value=\"#cfcfcf\" name=\"border\" condition=\"showDesc\" selected>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <input type=\"checkbox\" title=\"Decoration\" name=\"showDecor\" condition=\"showImage\" checked>\n        <input type=\"color\" title=\"Decoration Color\" value=\"#009472\" name=\"decor\" condition=\"showImage\" selected>\n        <header>List</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"color\" title=\"Icon Color\" value=\"#ffffff\" name=\"icon\" selected>\n        <input type=\"color\" title=\"Icon BG\" value=\"#262626\" name=\"iconBg\" selected>\n        <input type=\"color\" title=\"Icon Active BG\" value=\"#009472\" name=\"active\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#2f2f2f\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#262626\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-3 card\">\n                <div class=\"desc-wrapper\" mbr-if=\"showDesc\">\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-desc, .desc-wrapper\">\n                        Questions\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-9 card\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>? שאלות נפוצות</b></h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 card\">\n                <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                    <img src=\"@PROJECT_PATH@/assets/images/oskar-yildiz-cokptijmgza-unsplash-1-838x838.jpg\" alt=\"code\">\n                    <div class=\"decor-wrap\" mbr-if=\"showDecor\"></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-8 card\">\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\"><p><b>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;אתה לא צעיר מידי ופחות מנוסה</b></p></h4>\n                                <span class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </span>\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>&nbsp;בעייני לא וגם בעיני הלקוחות שלי, עם הידע והטאצ האישי שלי תהיו מרוצים מאוד, בנוסף עצם היותי צעיר זה יתרון, אני נענה מהר לבקשת הלקוח ומוודא שהוא מרוצה ב 100%</b></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\" style=\"text-align:right\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\"><p><b>\n                                    </b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;<b>תוך כמה זמן יש לי אתר</b></p></h4>\n                                <span class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </span>\n                            </a>\n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>זה הרוב תלוי בך, אני יכול להקים אתר ב7 ימים. הכול משתנה בין אדם לאדם<br>אם זה אדם חרוץ שמשקיע על האתר שלו כל יום שלוח תכנים <br>ומבצע מה שאני דורש ממנו זה בערך שבוע . אך לפעמים יכול לקחת יותר<br>אם זה מישהו שמורח את הזמן זה יכול לקחת לפעמים גם חודש<br></b>!<b>הכל תלוי בך</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" style=\"text-align:right\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\"><p><b>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; איך יש לך זמן לשלב גם לימודים וגם עבודה</b></p></h4>\n                                <span class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </span>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>אז השאלה הזאת מאוד נפוצה התשובה היא פשוטה אני\n<br>בן אדם חרוץ שמשקיע בכל דבר שאני מתחיל בחיים לא עוזב\n<br>משהו באמצא וככה נשאר לי בעצם כל יום כמה שעות שאני יכול לעבוד</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\"><p><b>איך אתה מתמודד עם בעיות טכניות שעלולות להתרחש בזמן בנייה של אתר</b></p></h4>\n                                <span class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </span>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>בדרך כלל אני מצליח להסתדר עם הכול ואם אני לא מצליח יש לי חברים בתחום שמבינים ובנוים גם</b></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\"><b>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; יש לך תיק עבודות</b></h4>\n                                <span class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </span>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>אז כן יש לי תיק עבודות ואתר אחד שעומד וכמה בתהליכי הרמה ועוד אתרים שבניתי&nbsp;</b><br><b>לדוגמאות ועוד</b></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">\n                                    What sets your recruitment company apart from others?\n                                </h4>\n                                <span class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </span>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    We pride ourselves on our personalized approach, industry expertise, and commitment\n                                    to finding not only the right skills but also the right cultural fit for your\n                                    organization.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tQoErSVHGz",
          "_anchor": "list01-d",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 20px",
                "@media (max-width: 992px)": {
                  "padding": "0 6px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 6px"
              }
            },
            ".row": {
              "margin": "0",
              "padding": "50px 150px",
              "border-radius": "20px",
              "background-color": "@container",
              "@media (max-width: 1440px)": {
                "padding": "50px 32px",
                "margin": "0"
              },
              "@media (max-width: 1200px)": {
                "padding": "50px 8px"
              },
              "@media (max-width: 992px)": {
                "padding": "50px 60px"
              },
              "@media (max-width: 768px)": {
                "padding": "50px 30px"
              },
              ".card": {
                "padding": "0",
                "border-radius": "0 !important",
                "overflow": "visible"
              }
            },
            ".title-wrapper": {
              "padding-right": "30px",
              "margin-bottom": "40px",
              "height": "100%",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "& when (@reverseContent)": {
                "padding-right": "0",
                "padding-left": "30px",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              ".mbr-section-title": {
                "margin-bottom": "50px",
                "span": {
                  "color": "@title"
                }
              },
              ".mbr-section-btn": {
                ".btn": {
                  "margin-bottom": "0"
                }
              }
            },
            ".list-wrapper": {
              "padding-right": "30px",
              "margin-bottom": "40px",
              "& when (@reverseContent)": {
                "padding-right": "0",
                "padding-left": "30px",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              ".list-title": {
                "margin-bottom": "22px"
              },
              ".list": {
                "margin": "0",
                "padding": "0",
                "list-style-type": "none",
                ".item-wrap": {
                  "margin-bottom": "22px",
                  "transition": "all 0.3s ease-in-out",
                  "&:last-child": {
                    "margin-bottom": "0"
                  },
                  "&:hover, &:focus": {
                    "color": "@active"
                  }
                }
              }
            },
            ".border-wrap": {
              "height": "1px",
              "opacity": ".1",
              "margin-bottom": "40px",
              "background-color": "@border"
            },
            ".copyright": {
              "opacity": ".3",
              "margin-bottom": "0",
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".list-title": {
              "color": "#00775c",
              "text-align": "center"
            },
            ".list": {
              "color": "#ffffff"
            },
            ".list, .item-wrap": {
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "right"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "agentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 agentm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Secondary Color\" value=\"#009472\" name=\"title\" condition=\"showTitle\" selected>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"List 1\" name=\"showList_1\" checked>\n        <input type=\"checkbox\" title=\"List 2\" name=\"showList_2\" checked>\n        <input type=\"checkbox\" title=\"List Title\" name=\"showListTitle\" condition=\"showList_1 || showList_2\" checked>\n        <input type=\"color\" title=\"Active Color\" value=\"#009472\" name=\"active\" condition=\"showList_1 || showList_2\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#ffffff\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"color\" title=\"Container BG\" value=\"#2f2f2f\" name=\"container\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-5 card\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle || showButtons\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">עמית&nbsp;<span>שכטר</span><br><span>בונה</span>&nbsp;אתרים</h2>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info-outline\" href=\"index.html#form01-0\" data-app-placeholder=\"Type Text\">דברו איתי<br></a></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showList_1\">\n                <div class=\"list-wrapper\">\n                    <h3 class=\"list-title mbr-fonts-style\" mbr-if=\"showListTitle\" data-app-selector=\".list-title\" mbr-theme-style=\"display-7\"><b>\n                        אודות</b></h3>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\"><a href=\"index.html#header01-g\" class=\"text-white text-primary\"><b>מי אני</b></a></li><a href=\"index.html#header01-g\" class=\"text-primary\"><b>\n                        </b></a><li class=\"item-wrap\"><i style=\"font-size: 1rem; background-color: transparent;\"><a href=\"index.html#features1-1\" class=\"text-white text-primary\"><b>למה אצלי</b></a></i></li><li class=\"item-wrap\"><b><a href=\"index.html#pricing02-v\" class=\"text-white\">השירותים שלי</a></b></li><li class=\"item-wrap\"><a href=\"index.html#list01-d\" class=\"text-white text-primary\" style=\"font-size: 1rem; background-color: transparent;\"><b>שאלות נפוצות</b></a><br></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 card\" mbr-if=\"showList_2\">\n                <div class=\"list-wrapper\">\n                    <h3 class=\"list-title mbr-fonts-style\" mbr-if=\"showListTitle\" data-app-selector=\".list-title\" mbr-theme-style=\"display-7\"><b>התהליך והמחיר</b></h3>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\"><span style=\"font-size: 1rem; background-color: transparent;\"><a href=\"התהליך והמחיר.html#header12-h\" class=\"text-white text-primary\"><b>הסבר קצר על התהליך</b></a></span></li><li class=\"item-wrap\"><a href=\"התהליך והמחיר.html#features03-3\" class=\"text-white text-primary\"><b>?מהי התחייבות שלכם&nbsp;</b></a></li><li class=\"item-wrap\"><b><span style=\"font-size: 1rem;\"><a href=\"התהליך והמחיר.html#pricing01-d\" class=\"text-info text-primary\">מחירים</a></span><br></b></li><li class=\"item-wrap\"><br></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 card\">\n                <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                <p class=\"mbr-fonts-style copyright\" mbr-theme-style=\"display-7\" data-app-selector=\".copyright\" data-app-placeholder=\"Type Text\" mbr-if=\"showCopy\"><b>\n                    כל הזכיות שמורות לבונה האתר עמית שכטר <a href=\"tel:+972537155757\" class=\"text-info\">053-715-5757</a></b></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tQoEruir7N",
          "_anchor": "footer01-c",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "התהליך והמחיר.html": {
      "settings": {
        "title": "מחירים והסברים|הסבר על תהליך בניית אתר",
        "order": "1",
        "meta_descr": "בניית אתרים מקצועיים ומותאמים אישית, שיהפכו את העסק שלך להצלחה.\nאתרים מקצועיים ויעילים נוחים לשימוש, מהירים וידידותיים למנועי החיפוש.\nאנו משלבים בין ניסיון רב שנים, ידע טכנולוגי מתקדם ויצירתיות רבה, המתאימים לצרכים הייחודיים של כל לקוח.\nהאתרים שלנו מאופיינים בעיצוב מרהיב, תוכן איכותי ותכנון פונקציונלי. \nבין השירותים שלנו ניתן למצוא:\nבניית אתרי תדמית, בניית אתרי מסחר אלקטרוני, בניית אתרי פורטל , בניית אתרי חדשות\nבניית אתרי קהילה, בניית אתרי אפליקציות, דפי נחיתה ועוד.",
        "footer_custom": "",
        "password_protect_password": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            ".navbar-dropdown": {
              "& when not (@transparent)": {
                "background-color": "@menuBgColor !important"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity) !important"
              },
              "padding": "0",
              "& when (@sticky)": {
                "position": "absolute !important"
              }
            },
            "background-color": "transparent",
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "& when not (@transparent)": {
                  "background-color": "@menuBgColor !important"
                },
                "& when (@transparent)": {
                  "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity) !important"
                },
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%"
                },
                "background": "@menuBgColor"
              }
            },
            ".menu_box": {
              "flex-wrap": "nowrap",
              "@media (max-width: 991px)": {
                ".navbar.opened, .navbar-collapse": {
                  "background-color": "@menuBgColor !important",
                  "transition": "all 0s ease 0s"
                },
                "flex-direction": "column",
                "align-items": "flex-start"
              }
            },
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "nav.navbar": {
                "position": "fixed",
                "padding-top": "1rem",
                "padding-bottom": "1rem"
              }
            },
            "& when (@showSidebar)": {
              ".icons-menu-main": {
                "display": "none",
                "@media (max-width: 991px)": {
                  "max-width": "100%",
                  "margin": "1rem 0 1rem 1rem",
                  "display": "flex"
                }
              },
              ".mbr-section-btn-main": {
                "display": "none",
                "@media (max-width: 991px)": {
                  "margin-top": "1rem",
                  "display": "block"
                }
              }
            },
            "& when not (@showSidebar)": {
              ".icons-menu-main": {
                "display": "flex",
                "flex-wrap": "wrap",
                "min-width": "150px",
                "@media (max-width: 991px)": {
                  "min-width": "auto",
                  "max-width": "100%",
                  "margin": "1rem 0 1rem 1rem"
                }
              },
              ".mbr-section-btn-main": {
                "@media (max-width: 991px)": {
                  "margin-top": "1rem"
                }
              }
            },
            ".btn": {
              "min-height": "auto",
              "box-shadow": "none",
              "margin-top": "0",
              "&:hover": {
                "box-shadow": "none"
              }
            },
            "@media (min-width: 992px)": {
              ".offcanvas": {
                "padding": "12rem 64px 0",
                "width": "35%",
                "background-color": "@offSidebarColor"
              },
              ".offcanvas_image img": {
                "width": "auto",
                "object-fit": "cover",
                "display": "inline-block"
              },
              ".offcanvas-header": {
                "position": "relative",
                "padding": "0",
                ".btn-close": {
                  "position": "absolute",
                  "top": "-70px",
                  "right": "0",
                  "width": "35px",
                  "height": "30px"
                }
              },
              ".offcanvas-body": {
                "text-align": "center",
                "padding": "0",
                ".mbr-text, .mbr-section-subtitle": {
                  "margin-bottom": "32px"
                },
                ".offcanvas_contact": {
                  "margin": "0"
                }
              },
              ".offcanvas_box": {
                "button.btn_offcanvas": {
                  "outline": "none",
                  "width": "40px",
                  "height": "40px",
                  "cursor": "pointer",
                  "transition": "all 0.2s",
                  "position": "relative",
                  "align-self": "center",
                  ".hamburger span": {
                    "position": "absolute",
                    "right": "0",
                    "width": "40px",
                    "height": "2px",
                    "border-right": "5px",
                    "background-color": "@hamburgerColor",
                    "&:nth-child(1)": {
                      "top": "18px",
                      "transition": "all 0.2s"
                    },
                    "&:nth-child(2)": {
                      "top": "25px",
                      "transition": "all 0.2s"
                    }
                  },
                  "&:hover .hamburger span": {
                    "width": "36px",
                    "&:nth-child(2)": {
                      "width": "33px",
                      "transition-delay": "0.2s"
                    }
                  }
                }
              },
              "ul.navbar-nav": {
                "padding-bottom": "1.5rem"
              },
              ".dropdown-menu .dropdown-toggle[data-toggle=\"dropdown-submenu\"]::after, .link.dropdown-toggle::after": {
                "display": "inline-block",
                "width": "7px",
                "height": "7px",
                "margin-left": ".5rem",
                "margin-bottom": "2px",
                "content": "\"\"",
                "border": "2px solid",
                "border-left": "none",
                "border-top": "none",
                "transform": "rotate(-45deg)"
              },
              ".link.dropdown-toggle::after": {
                "padding": "0 !important",
                "transform": "rotate(45deg)"
              },
              "li.nav-item": {
                "position": "relative",
                "display": "inline-block",
                "padding": "0 !important",
                "vertical-align": "middle",
                "line-height": "2em !important",
                "font-weight": "600 !important",
                "text-decoration": "none",
                "letter-spacing": "0 !important",
                "z-index": "1"
              },
              ".lg_brand": {
                "margin": "0 1rem"
              },
              ".navbar-nav.nav-dropdown": {
                "display": "-webkit-flex",
                "width": "100%",
                "justify-content": "center",
                "min-width": "200px"
              }
            },
            ".nav-item": {
              "margin": "4px 15px",
              "@media (min-width: 1200px)": {
                "margin": "4px 20px"
              },
              "@media (max-width: 991px)": {
                "margin": "0 !important"
              },
              ".nav-link": {
                "transition": "all 0.5s ease-out",
                "&:hover, &:focus": {
                  "color": "@secondaryColor !important"
                }
              }
            },
            ".dropdown-menu": {
              "border-radius": "0",
              "box-shadow": "none",
              "text-align": "left",
              "@media (min-width: 992px)": {
                "padding": "18px 34px 22px",
                "min-width": "100px",
                "top": "auto !important",
                "left": "-40px !important",
                "&.dropdown-submenu": {
                  "left": "215px !important",
                  "top": "-45% !important"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".dropdown-menu .dropdown-toggle[data-toggle=\"dropdown-submenu\"]::after, .link.dropdown-toggle::after": {
                "display": "inline-block",
                "width": "7px",
                "height": "7px",
                "margin-left": ".5rem",
                "margin-bottom": "2px",
                "content": "\"\"",
                "border": "2px solid",
                "border-left": "none",
                "border-top": "none",
                "transform": "rotate(-45deg)",
                "right": "15px",
                "position": "absolute",
                "margin-top": "-2px"
              },
              ".show.dropdown-toggle[aria-expanded=\"true\"]::after": {
                "transform": "rotate(45deg)",
                "margin-top": "-4px"
              },
              ".offcanvas_box": {
                "display": "none"
              }
            },
            ".dropdown-item": {
              "border": "none",
              "font-weight": "300 !important"
            },
            ".nav-dropdown .link": {
              "font-weight": "600 !important",
              "padding": "0 !important",
              "margin": "0 !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0"
            },
            ".container": {
              "display": "flex",
              "margin": "auto"
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor",
              "font-size": "17px",
              "margin-right": "10px",
              "margin-bottom": "5px",
              "&:last-child": {
                "margin-right": "0"
              },
              "width": "25px",
              "height": "25px",
              "border-radius": "50%",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "transition": "all 0.2s ease-in-out",
              "&:hover": {
                "opacity": ".5"
              }
            },
            ".navbar-nav": {
              "@media (min-width: 992px)": {
                "margin": "0"
              },
              "margin": "0 1rem"
            },
            ".dropdown-menu, .navbar.opened": {
              "background-color": "@transparent !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "0.5rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "70px",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "border-bottom-width": "0",
              "@media (max-width: 992px)": {
                "min-height": "30px",
                "max-height": "none"
              },
              "&:not(.navbar-short)": {},
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "0",
                "margin": "8px 0"
              },
              ".navbar-logo img": {
                "max-width": "50px",
                "min-height": "50px",
                "object-fit": "contain",
                "border-radius": "10px !important"
              },
              ".navbar-collapse": {
                "justify-content": "center",
                "& when (@showLogo), (@showBrand)": {
                  "justify-content": "center"
                },
                "& when not (@showSidebar)": {
                  "justify-content": "space-between"
                },
                "z-index": "1"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem",
                  "text-align": "left"
                },
                ".icons-menu": {
                  "padding": "0"
                }
              },
              "@media (max-width: 991px)": {
                ".nav-item": {
                  "padding": ".5rem 0"
                },
                ".navbar-collapse": {
                  "padding": "34px 0",
                  "border-radius": "16px",
                  "width": "100%"
                },
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".dropdown-menu": {
                  "padding": "6px 0 6px 15px",
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto",
                    "margin-top": "-0.4rem"
                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
                  }
                },
                "ul.navbar-nav": {
                  "overflow": "hidden",
                  "li": {
                    "margin": "0"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0 !important",
                  "margin": "0",
                  "margin-top": "8px",
                  "text-align": "left"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
                  "flex-basis": "auto",
                  "word-break": "break-word",
                  "padding-right": "0",
                  "width": "100%",
                  "justify-content": "space-between"
                },
                ".navbar-toggler": {
                  "flex-basis": "auto"
                },
                ".icons-menu": {
                  "padding": "0"
                }
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo": {
                  "img": {
                    "height": "2.5rem !important"
                  }
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".navbar-brand": {
              "min-height": "70px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important",
                "font-weight": "600"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "2px 10px !important"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap",
              "padding": "0"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "170px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "48px",
              "height": "48px",
              "border-radius": "50%",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "color": "@menuBgColor",
              "background": "@hamburger",
              ".hamburger span": {
                "position": "absolute",
                "right": "10px",
                "margin-top": "14px",
                "width": "26px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "16px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "flex-start"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding": "0",
              "text-align": "center",
              "margin-bottom": "35px"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            },
            ".navbar-dropdown .navbar-logo": {
              "margin-right": "15px"
            },
            "@media (min-width: 768px)": {
              ".container-fluid": {
                "padding-left": "40px",
                "padding-right": "40px"
              }
            },
            ".mbr-section-btn-main": {
              "& when not (@showSidebar)": {
                "display": "flex",
                "justify-content": "flex-end",
                "@media (max-width: 992px)": {
                  "display": "block",
                  "padding": "0",
                  "&:hover": {
                    "display": "green"
                  }
                }
              },
              ".btn": {
                "border-width": "1px",
                "margin": "8px",
                "min-width": "180px"
              }
            },
            ".navbar-caption:hover": {
              "color": "@primaryColor"
            },
            ".dropdown-menu.dropdown-submenu": {
              "@media (min-width: 992px)": {
                "left": "175px !important",
                "top": "-45% !important"
              }
            },
            ".text_widget": {
              "margin-bottom": "32px",
              "a": {
                "transition": "all 0.3s ease-out",
                "&:hover, &:focus": {
                  "opacity": ".6"
                }
              }
            },
            ".mbr-section-subtitle": {
              "color": "#131313",
              "text-align": "center"
            },
            ".navbar-caption": {
              "color": "#009472"
            },
            ".mbr-text": {
              "color": "#131313",
              "text-align": "center"
            },
            ".mbr-section-subtitle, .text_widget, .mbr-section-btn": {
              "text-align": "center"
            },
            ".nav-link": {
              "text-align": "right"
            },
            "a[class*=\"text-\"]:not(.nav-link):not(.dropdown-item):not([role]):not(.navbar-caption):hover": {
              "background-image": "none"
            }
          },
          "_name": "menu01",
          "_sourceTheme": "agentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 agentm5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" condition=\"false\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <input type=\"range\" title=\"Amount\" name=\"iconsAmount\" min=\"0\" max=\"4\" step=\"1\" value=\"3\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Color Icons\" name=\"iconsColor\" value=\"#131313\" condition=\"showIcons\">\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\" condition=\"false\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color Menu\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#009472\">\n        <input type=\"color\" title=\"Hamburger Container\" name=\"hamburger\" value=\"#e6e6e6\">\n        <header>Sidebar</header>\n        <input type=\"checkbox\" title=\"Sidebar\" name=\"showSidebar\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" condition=\"showSidebar\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" condition=\"showSidebar\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" condition=\"showSidebar\" checked>\n        <input type=\"color\" title=\"OffSidebar Color\" name=\"offSidebarColor\" value=\"#f5f5f5\" condition=\"showSidebar\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div class=\"menu_box\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand d-flex\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"@THEME_PATH@/components/index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/2b5ddd4d-38be-4d8c-b348-60ecc2aa5fb4-100x65.jpg\" alt=\"bwas\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\"><a class=\"navbar-caption text-secondary\" data-app-selector=\".navbar-caption\" href=\"index.html#top\" data-app-placeholder=\"Type Text\">BWAS&nbsp;</a></span>\n                <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                    <div class=\"hamburger\">\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                </button>\n            </div>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link text-primary dropdown-toggle\" href=\"page1.html#header02-1\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">&nbsp; התהליך והמחיר</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-981\"><a class=\"text-primary dropdown-item\" style=\"text-align:right\" href=\"התהליך והמחיר.html#header12-h\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">הסבר קצר על התהליך</a><a class=\"text-primary dropdown-item\" style=\"text-align:right\" href=\"התהליך והמחיר.html#features03-3\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">?מהי התחייבות שלכם </a><a class=\"text-primary dropdown-item\" style=\"text-align:right\" href=\"התהליך והמחיר.html#pricing01-d\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">המחירים</a></div>\n                    </li><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"index.html#list01-d\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">שאלות נפוצות</a></li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link text-primary\" href=\"index.html#contacts01-3\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">צרו קשר</a>\n                    </li><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"index.html#pricing02-v\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">השירותים שלי</a></li><li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link text-primary dropdown-toggle\" href=\"@THEME_PATH@/components/index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">אודות</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-774\"><a class=\"text-primary dropdown-item\" style=\"text-align:right\" href=\"index.html#header01-g\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">מי אני<br></a><a class=\"text-primary show dropdown-item\" style=\"text-align:right\" href=\"index.html#features1-1\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">למה אצלי</a><a class=\"text-primary show dropdown-item\" style=\"text-align:right\" href=\"index.html#features3-q\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">התחזוקה שלי</a></div>\n                    </li></ul>\n                <div class=\"icons-menu-main\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn-main\" mbr-if=\"showButtons\" role=\"tablist\"><a class=\"btn btn-primary-outline\" href=\"index.html#form01-0\" data-app-placeholder=\"Type Text\">דברו איתי</a></div>\n            </div>\n            <div class=\"offcanvas_box\" mbr-if=\"showSidebar\">\n                <button class=\"btn_offcanvas\" type=\"button\" data-bs-toggle=\"offcanvas\" data-bs-target=\"#offcanvasRight\" aria-controls=\"offcanvasRight\">\n                    <div class=\"hamburger\">\n                        <span></span>\n                        <span></span>\n                    </div>\n                </button>\n                <div class=\"offcanvas offcanvas-end\" tabindex=\"-1\" id=\"offcanvasRight\" aria-labelledby=\"offcanvasRightLabel\">\n                    <div class=\"offcanvas-header\">\n                        <button type=\"button\" class=\"btn-close text-reset\" data-bs-dismiss=\"offcanvas\" aria-label=\"Close\"></button>\n                    </div>\n                    <div class=\"offcanvas-body\">\n                        <div mbr-if=\"showImage\" class=\"offcanvas_image\">\n                            <img src=\"@THEME_PATH@/components/_images/logo.png\" alt=\"Mobirise\" mbr-style=\"{'height': imageSize + 'rem'}\">\n                        </div>\n                        <h3 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-subtitle, .text_widget, .mbr-section-btn\" mbr-theme-style=\"display-5\">\n                            AgentM5\n                        </h3>\n                        <div class=\"offcanvas_contact\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                Home insurance, also known as homeowners insurance or property insurance, typically\n                                includes coverage for a range of risks and perils that can affect your home and its\n                                contents. It provides financial protection in the event of damage or loss due to various\n                                circumstances.\n                            </p>\n                            <p class=\"text_widget mbr-fonts-style\" mbr-if=\"showContacts\" data-app-selector=\".text_widget\" mbr-theme-style=\"display-4\">\n                                <a href=\"#\" class=\"text-secondary\">mobi@rise.com</a>\n                                <br><br>\n                                <a href=\"tel:12345678900\" class=\"text-secondary\">+1 234-567-8900</a>\n                            </p>\n                        </div>\n                        <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                            <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-youtube socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                            </a>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                Contacts\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "tQoGZRZKrG",
          "_anchor": "menu01-0",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "background": "@wrapBgColor",
              "border-radius": "4px",
              "@media (max-width: 767px)": {
                "padding": "1rem"
              },
              "@media (min-width: 768px) and (max-width: 991px)": {
                "padding": "2rem"
              },
              "@media (min-width: 992px)": {
                "padding": "4rem"
              }
            },
            ".blue-text": {
              "color": "#131313"
            },
            ".green-text": {
              "color": "#00775c"
            }
          },
          "_name": "header12",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header12\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Wrap Bg\" name=\"wrapBgColor\" value=\"#cfcfcf\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background8.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-12 col-md-12 col-lg-9\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-center\">\n<div class=\"card-title mbr-fonts-style mb-3\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n    <b class=\"blue-text\">בניית </b><b class=\"green-text\">אתר</b>\n</div>\n\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b>:תכנון\n<br>הגדרת מטרות: הבנייה תתחיל עם הגדרת מטרות האתר. לדוג', האם זה אתר אישי, עסקי, חינוכי או מסחרי\n<br>איסוף רעיונות ודרישות: אילו פונקציות ותכונות תרצה לכלול באתר? דפים, תמונות, טפסים, תכנים מרובים ועוד\n<br>\n<br>:עיצוב\n<br>בחירת עיצוב ופריסה: בחירת עיצוב כוללת את הצבעים, הגופנים, תמונות וכלי נוספים. ישנם מספר כלים ופלטפורמות לבניית אתרים, וניתן גם להשתמש בשירותי עיצוב מוכנים<br>\n<br>:פיתוח\n<br>קידוד ותכנות: בניית האתר דורשת יכולות תכנות. שפות תכנות נפוצות כוללות<br>HTML, CSS, ו-JavaScript.<br>&nbsp;יתר על כך, פלטפורמות כמו מספקות כלים וממשקים שפשוטים יותר לשימוש\n<br>\n<br>:בדיקה\n<br>בדיקה פנימית: בודקים את האתר פנימית כדי לוודא שכל הפונקציות והתכנים עובדים כצפוי\n<br>בדיקת תגובה: האתר צריך להיות גמיש ולהצטייד בצורה טובה על ידי מכשירים שונים (טלפונים ניידים,  מחשבים ועוד)\n<br>\n<br>:פרסום\n<br>רישום דומיין ואחסון: רכש דומיין (שם האתר) ושטח אחסון איכותי. החברות שמספקות שירות זו נקראות חברות אחסון אתרים\n<br>העלאת האתר: אחרי שכל ההכנות הן מוכנות, ניתן להעלות את האתר לשרת האינטרנט\n<br>\n<br>:תחזוקה ושדרוג\n<br>עדכונים ושדרוגים: עם הזמן, יתכן ותרצה להוסיף פונקציות חדשות, לשדרג את העיצוב, ולכן יש לקחת בחשבון את שירותי&nbsp;</b><br><b>התחזוקה<br><br></b></p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Start Now &gt;</a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tYiVrBnPES",
          "_anchor": "header12-h",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 20px",
                "@media (max-width: 992px)": {
                  "padding": "0 6px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 6px"
              }
            },
            ".row": {
              "margin": "0",
              "background-color": "@container",
              "border-radius": "20px",
              "padding": "150px",
              "@media (max-width: 1440px)": {
                "padding": "150px 32px"
              },
              "@media (max-width: 1200px)": {
                "padding": "150px 8px"
              },
              "@media (max-width: 992px)": {
                "padding": "70px 60px"
              },
              "@media (max-width: 768px)": {
                "padding": "70px 30px"
              },
              ".card": {
                "padding": "0",
                "border-radius": "0 !important",
                "overflow": "visible"
              }
            },
            ".desc-wrapper": {
              "padding-right": "32px",
              "margin-bottom": "64px",
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              "& when (@reverseContent)": {
                "padding-right": "0",
                "padding-left": "32px",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              ".mbr-desc": {
                "padding": "10px 18px",
                "display": "inline-flex",
                "border": "1px solid @borderDesc",
                "border-radius": "30px",
                "margin-bottom": "0"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "64px",
              "& when (@showDecor)": {
                "margin-bottom": "110px"
              },
              "span": {
                "color": "@title"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".cards-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr",
              "gap": "22px",
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".item": {
                "position": "relative",
                ".card-decor": {
                  "position": "absolute",
                  "top": "-40px",
                  "left": "0",
                  "height": "55px",
                  "width": "130px",
                  "display": "inline-flex",
                  "background-color": "@decor",
                  "border-radius": "16px 16px 0 0"
                },
                ".item-wrapper": {
                  "height": "100%",
                  ".card-box": {
                    "height": "100%",
                    "position": "relative",
                    "padding": "40px",
                    "border-radius": "16px",
                    "background-color": "@card",
                    "border": "1px solid @border",
                    "z-index": "1",
                    "@media (max-width: 992px)": {
                      "padding": "22px",
                      "margin-bottom": "22px"
                    },
                    ".icon-wrap": {
                      "position": "absolute",
                      "top": "-25px",
                      "left": "0",
                      "width": "100%",
                      "padding": "0 40px",
                      "@media (max-width: 992px)": {
                        "padding": "0 22px",
                        "top": "-20px"
                      },
                      ".mbr-iconfont": {
                        "font-size": "22px",
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "width": "50px",
                        "height": "50px",
                        "border-radius": "100%",
                        "background-color": "@iconBg",
                        "color": "@icon"
                      }
                    },
                    ".number-wrapper": {
                      "margin-bottom": "32px",
                      ".number-wrap": {
                        "display": "inline-flex",
                        "align-items": "center",
                        ".dot-wrap": {
                          "width": "12px",
                          "height": "12px",
                          "background-color": "@dot",
                          "border-radius": "50%",
                          "margin-right": "10px"
                        },
                        ".card-number": {
                          "margin-bottom": "0"
                        }
                      }
                    },
                    ".card-title": {
                      "margin-bottom": "0"
                    },
                    ".card-text": {
                      "margin": "100px 0 0 0",
                      "@media (max-width: 992px)": {
                        "margin": "64px 0 0 0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-desc": {
              "color": "#262626"
            },
            ".mbr-section-title": {
              "color": "#000001",
              "text-align": "center"
            },
            ".card-number": {
              "color": "#cfcfcf"
            },
            ".card-title": {
              "color": "#131313",
              "text-align": "center"
            },
            ".card-text": {
              "color": "#131313",
              "text-align": "center"
            },
            ".icon-wrap": {
              "text-align": "right"
            }
          },
          "_name": "features03",
          "_sourceTheme": "agentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 agentm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Secondary Color\" value=\"#009472\" name=\"title\" condition=\"showTitle\" selected>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"color\" title=\"Description Border\" value=\"#cfcfcf\" name=\"borderDesc\" condition=\"showDesc\" selected>\n        <input type=\"color\" title=\"Container BG\" value=\"#f5f5f5\" name=\"container\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Dot\" name=\"showDot\" checked>\n        <input type=\"color\" title=\"Dot Color\" value=\"#009472\" name=\"dot\" condition=\"showDot\" selected>\n        <input type=\"checkbox\" title=\"Card Number\" name=\"showNumber\" checked>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Decoration\" name=\"showDecor\" checked>\n        <input type=\"color\" title=\"Decoration Color\" value=\"#009472\" name=\"decor\" condition=\"showDecor\" selected>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#009472\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Icon BG\" value=\"#e6e6e6\" name=\"iconBg\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#ffffff\" name=\"card\" selected>\n        <input type=\"color\" title=\"Card Border\" value=\"#cfcfcf\" name=\"border\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#262626\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-3 card\">\n                <div class=\"desc-wrapper\" mbr-if=\"showDesc\">\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-desc, .desc-wrapper\">\n                        Reasons\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-9 card\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">?מהי הת<span>חייבות שלכם&nbsp;</span></h2>\n                </div>\n            </div>\n            <div class=\"col-12 card\">\n                <div class=\"cards-wrapper\">\n                    \n                    <div class=\"item features-without-image item-mb active\">\n                        <div class=\"card-decor\" mbr-if=\"showDecor\"></div>\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <div class=\"number-wrapper\" mbr-if=\"showDot || showNumber\">\n                                    <div class=\"number-wrap\">\n                                        <div class=\"dot-wrap\" mbr-if=\"showDot\"></div>\n                                        <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showNumber\" data-app-selector=\".card-number, .number-wrapper\">\n                                            / 01\n                                        </p>\n                                    </div>\n                                </div>\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">זמינות מהצד שלכם</h4>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\"><b>זמינות מצד הלקוח – כדי שהעבודה תתקדם בצורה יעילה וללא עיכובים, חשוב שתהיו זמינים לתקשורת, תיאומים ואישור חומרים. אני מתחייב לעמוד בזמנים – ואתם מתחייבים לשתף פעולה כדי שזה יקרה.</b><br></p>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-without-image item-mb\">\n                        <div class=\"card-decor\" mbr-if=\"showDecor\"></div>\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <div class=\"number-wrapper\" mbr-if=\"showDot || showNumber\">\n                                    <div class=\"number-wrap\">\n                                        <div class=\"dot-wrap\" mbr-if=\"showDot\"></div>\n                                        <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showNumber\" data-app-selector=\".card-number, .number-wrapper\">\n                                            / 02\n                                        </p>\n                                    </div>\n                                </div>\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">מפגשים בזום אחת לשבוע</h4>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\"><b>פגישה שבועית בזום – לפחות אחת לשבוע, נבצע פגישת זום קצרה להצגת ההתקדמות, שינויים, התאמות ותיאום הציפיות מול גרסת האתר.<br></b><br></p>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-without-image item-mb\">\n                        <div class=\"card-decor\" mbr-if=\"showDecor\"></div>\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <div class=\"number-wrapper\" mbr-if=\"showDot || showNumber\">\n                                    <div class=\"number-wrap\">\n                                        <div class=\"dot-wrap\" mbr-if=\"showDot\"></div>\n                                        <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showNumber\" data-app-selector=\".card-number, .number-wrapper\">\n                                            / 03</p>\n                                    </div>\n                                </div>\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">מקדמה</h4>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\"><b>מקדמה של 40% – בתחילת העבודה נגבה מקדמה בגובה 40% מהסכום הכולל. זה נועד להבטיח רצינות, לאפשר לי להתחיל את העבודה ולהשקיע את הזמן והמשאבים הדרושים כבר מהשלב הראשון.</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tQoH25qjCa",
          "_anchor": "features03-3",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 20px",
                "@media (max-width: 992px)": {
                  "padding": "0 6px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 6px"
              }
            },
            ".row": {
              "margin": "0",
              "padding": "150px",
              "@media (max-width: 1440px)": {
                "padding": "150px 32px"
              },
              "@media (max-width: 1200px)": {
                "padding": "150px 8px"
              },
              "@media (max-width: 992px)": {
                "padding": "70px 60px"
              },
              "@media (max-width: 768px)": {
                "padding": "70px 30px"
              },
              ".card": {
                "padding": "0",
                "border-radius": "0 !important",
                "overflow": "visible"
              }
            },
            ".desc-wrapper": {
              "padding-right": "32px",
              "margin-bottom": "64px",
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              "& when (@reverseContent)": {
                ".row": {
                  "flex-direction": "row-reverse"
                },
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              ".mbr-desc": {
                "padding": "10px 18px",
                "display": "inline-flex",
                "border": "1px solid @borderDesc",
                "border-radius": "30px",
                "margin-bottom": "0"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "64px",
              "& when (@showSubtitle)": {
                "margin-bottom": "110px"
              },
              "span": {
                "color": "@title"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".item": {
              "position": "relative",
              "margin-bottom": "60px",
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              "& when (@showSubtitle)": {
                "padding-top": "5px",
                "margin-bottom": "100px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "70px"
                },
                "&:before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "50%",
                  "background-color": "@subBg",
                  "border-radius": "16px 16px 0 0"
                }
              },
              "&:last-child": {
                "margin-bottom": "0 !important"
              },
              ".subtitle-wrapper": {
                "position": "absolute",
                "width": "100%",
                "top": "-45px",
                ".subtitle-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  "padding": "15px 80px 30px 22px",
                  "background-color": "@subBg",
                  "border-radius": "16px 16px 0 0",
                  "@media (max-width: 992px)": {
                    "padding": "15px 22px 30px"
                  },
                  ".dot-wrap": {
                    "width": "11px",
                    "height": "11px",
                    "background-color": "@dot",
                    "margin-right": "30px",
                    "border-radius": "50%"
                  },
                  ".mbr-section-subtitle": {
                    "margin-bottom": "0"
                  }
                }
              },
              ".item-wrapper": {
                "position": "relative",
                "z-index": "1",
                "background-color": "@card",
                "border-radius": "16px !important",
                "border": "1px solid @border",
                "padding": "60px",
                "@media (max-width: 992px)": {
                  "padding": "40px 22px"
                },
                ".card-box": {
                  "display": "grid",
                  "grid-template-columns": "1fr 1fr",
                  "gap": "100px",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".content-wrapper": {
                    "display": "flex",
                    "flex-direction": "column",
                    "justify-content": "space-between",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "50px",
                      "&:last-child": {
                        "margin-bottom": "0"
                      }
                    },
                    ".title-wrap": {
                      "margin-bottom": "50px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "40px"
                      },
                      ".card-title": {
                        "margin-bottom": "32px"
                      },
                      ".card-text": {
                        "margin-bottom": "0"
                      }
                    },
                    ".desc-wrap": {
                      "display": "flex",
                      "justify-content": "space-between",
                      "@media (max-width: 768px)": {
                        "display": "block"
                      },
                      ".item-desc": {
                        "width": "50%",
                        "@media (max-width: 768px)": {
                          "width": "100%",
                          "margin-bottom": "16px"
                        },
                        ".item-card-desc": {
                          "margin-bottom": "5px",
                          "opacity": ".5"
                        },
                        ".card-desc": {
                          "margin-bottom": "0"
                        }
                      }
                    },
                    ".list-wrapper": {
                      "margin-bottom": "50px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "40px"
                      },
                      ".list-title": {
                        "margin": "32px 0"
                      },
                      ".list-wrap": {
                        ".item-list": {
                          "display": "flex",
                          "align-items": "center",
                          "border-bottom": "1px solid @border",
                          "padding": "20px 0",
                          "&:first-child": {
                            "border-top": "1px solid @border"
                          },
                          ".card-number": {
                            "min-width": "30px",
                            "margin": "0 75px 0 0",
                            "@media (max-width: 768px)": {
                              "margin": "0 20px 0 0"
                            }
                          },
                          ".list-desc": {
                            "margin-bottom": "0"
                          }
                        }
                      }
                    },
                    ".price-wrapper": {
                      ".price-wrap": {
                        "display": "inline-flex",
                        "align-items": "center",
                        "@media (max-width: 992px)": {
                          "display": "block"
                        },
                        ".mbr-price": {
                          "margin": "0 50px 0 0",
                          "@media (max-width: 992px)": {
                            "margin": "0 0 20px 0"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-desc": {
              "color": "#262626"
            },
            ".mbr-section-title": {
              "color": "#131313",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
            ".card-title": {
              "color": "#131313",
              "text-align": "center"
            },
            ".card-text": {
              "color": "#131313",
              "text-align": "center"
            },
            ".item-card-desc": {
              "color": "#131313",
              "text-align": "center"
            },
            ".card-desc": {
              "color": "#131313",
              "text-align": "center"
            },
            ".list-title": {
              "color": "#009472",
              "text-align": "center"
            },
            ".card-number": {
              "color": "#cfcfcf"
            },
            ".list-desc": {
              "color": "#131313",
              "text-align": "center"
            },
            ".mbr-price": {
              "color": "#131313"
            },
            ".mbr-section-subtitle, .subtitle-wrapper": {
              "text-align": "center"
            },
            ".card-text P": {
              "text-align": "center"
            },
            ".mbr-desc, .desc-wrapper": {
              "text-align": "left"
            },
            ".price-container": {
              "text-align": "center",
              "margin": "20px"
            },
            ".original-price": {
              "text-decoration": "line-through",
              "color": "red"
            },
            ".discount-price": {
              "color": "green",
              "font-size": "1.2em"
            },
            ".mbr-price, .price-wrapper": {
              "color": "#2376a2"
            }
          },
          "_name": "pricing01",
          "_sourceTheme": "agentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing01 agentm5\" group=\"Pricing\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Secondary Color\" value=\"#009472\" name=\"title\" condition=\"showTitle\" selected>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"color\" title=\"Description Border\" value=\"#cfcfcf\" name=\"borderDesc\" condition=\"showDesc\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"color\" title=\"Subtitle BG\" value=\"#009472\" name=\"subBg\" condition=\"showSubtitle\" selected>\n        <input type=\"color\" title=\"Dot Color\" value=\"#ffffff\" name=\"dot\" condition=\"showSubtitle\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Description 1\" name=\"showDesc_1\" checked>\n        <input type=\"checkbox\" title=\"Card Description 2\" name=\"showDesc_2\" checked>\n        <input type=\"checkbox\" title=\"Card List\" name=\"showList\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"0\" max=\"4\" step=\"1\" value=\"3\" condition=\"showList\">\n        <input type=\"checkbox\" title=\"List Title\" name=\"showListTitle\" condition=\"showList\" checked>\n        <input type=\"checkbox\" title=\"List Desc\" name=\"showListDesc\" condition=\"showList\" checked>\n        <input type=\"checkbox\" title=\"List Number\" name=\"showListNumber\" condition=\"showList\" checked>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Card Border\" value=\"#cfcfcf\" name=\"border\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#ffffff\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#e6e6e6\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-3 card\">\n                <div class=\"desc-wrapper\" mbr-if=\"showDesc\">\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-desc, .desc-wrapper\">\n                        שירותים</p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-9 card\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">מחירים ל<span>אתרים</span></h2>\n                </div>\n            </div>\n            <div class=\"col-12 card\">\n                \n                <div class=\"item features-without-image item-mb active\">\n                    <div class=\"subtitle-wrapper\" mbr-if=\"showSubtitle\">\n                        <div class=\"subtitle-wrap\">\n                            <div class=\"dot-wrap\"></div>\n                            <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .subtitle-wrapper\" mbr-theme-style=\"display-4\">מחיר אתר עם דף 1-2</h3>\n                        </div>\n                    </div>\n                    <div class=\"item-wrapper\">\n                        <div class=\"card-box\">\n                            <div class=\"content-wrapper\">\n                                <div class=\"title-wrap\">\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>בניית אתר או דף נחיתה עד שני דפים</b></h4>\n                                    <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\"><b>אני מציע בניית אתר</b> <b>עד שני דפים&nbsp; במחיר נע של&nbsp;1000-1500</b>&nbsp;<b>ש\"ח בלבד</b>.חשוב לציין שאצלי המחיר שונה והוא תחרותי מאוד ביחס למחירים בשוק. בדרך כלל, בשוק נהוג לקחת על אתר של עד 2 דפים מחיר הנע בין\n<br>1600-2,000 ש\"ח\n<br><br><br><b>?מה כלול במחיר<br></b><br>.בניית אתר בסיסי ומותאם אישית לצרכים שלך<br>זמן הכנה של האתר הוא בין 1-2 שבועות, תלוי בדרישות ובתיאום עם הלקוח&nbsp;<br><br><b>תחזוקה שוטפת בעלות של 150</b> <b>ש\"ח לחודש</b> בלבד לאחר השנה הראשונה. לשם השוואה, מחירי התחזוקה בשוק נעים בין 250-400 ש\"ח לחודש<br></p>\n                                </div>\n                                <div class=\"desc-wrap\" mbr-if=\"showDesc_1 || showDesc_2\">\n                                    <div class=\"item-desc\" mbr-if=\"showDesc_1\">\n                                        <p class=\"item-card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-card-desc\"><b>סוג אתר</b></p>\n                                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-desc\"><b>עד 1-2 דפים</b><br></p>\n                                    </div>\n                                    <div class=\"item-desc\" mbr-if=\"showDesc_2\">\n                                        <p class=\"item-card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-card-desc\"><b>\n                                            זמן הכנה\n                                        </b></p>\n                                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-desc\"><b>1-2 שבועות</b><br></p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"content-wrapper\">\n                                <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                    <h5 class=\"list-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".list-title\"><b>המחיר עלול להשתנות בהתאם לאתר</b></h5>\n                                    <div class=\"list-wrap\" mbr-if=\"showList\">\n                                        <div class=\"item-list\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 01\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\"><b>אורך הדפים: </b>אם דף מסוים יחשב כמו שני דפים מבחינת היקף העבודה, המחיר עלול להשתנות<br></p>\n                                        </div>\n                                        <div class=\"item-list\" mbr-if=\"list > 1\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 02\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\">.<b>בקשות מיוחדות:</b> במידה והלקוח מבקש תוספות או שינויים מיוחדים, המחיר יתעדכן בהתאם<br></p>\n                                        </div>\n                                        <div class=\"item-list\" mbr-if=\"list > 2\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 03\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\"><b style>זמן הכנה: </b>זמן ההכנה של האתר משתנה בהתאם לדרישות. במידה והלקוח מעוניין להאיץ את תהליך ההכנה, עשוי להיות שינוי קל במחיר<br></p>\n                                        </div>\n                                        <div class=\"item-list\" mbr-if=\"list > 3\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 04\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\">\n                                                Family Size\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"price-wrapper\">\n                                    <div class=\"price-wrap\">                                     \n                                            <div class=\"price-container\">\n                                                <p class=\"original-price\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price, .price-wrapper\"><b>1600-2,000</b><br></p>\n                                                <p class=\"discount-price\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price, .price-wrapper\"><b>1000-1500</b></p>\n                                            </div>\n\n                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"index.html#form01-0\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>תשיארו פניה</a></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div><div class=\"item features-without-image item-mb\">\n                    <div class=\"subtitle-wrapper\" mbr-if=\"showSubtitle\">\n                        <div class=\"subtitle-wrap\">\n                            <div class=\"dot-wrap\"></div>\n                            <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .subtitle-wrapper\" mbr-theme-style=\"display-4\">בניית אתר עד 5 דפים</h3>\n                        </div>\n                    </div>\n                    <div class=\"item-wrapper\">\n                        <div class=\"card-box\">\n                            <div class=\"content-wrapper\">\n                                <div class=\"title-wrap\">\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>בניית אתר עד חמישה דפים</b></h4>\n                                    <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\"><b>אני מציע בניית אתר עד 5 דפים&nbsp;</b>במחיר נע של&nbsp;1800-2700 ש\"ח בלבד<b>.</b>&nbsp; המחיר שונה והוא תחרותי מאוד ביחס למחירים בשוק. בדרך כלל, בשוק נהוג לקחת על אתר עד של 5 דפים מחיר הנע בין <br>2,900-3,500 ש\"ח<br><br>?<b>מה כלול במחיר</b><b><br></b><br>.בניית האתר מותאמת אישית לצרכים שלך<br>.זמן ההכנה של האתר הוא בין 2-4 שבועות, תלוי בצרכים ובתיאום עם הלקוח<br><b><br>תחזוקה שוטפת&nbsp;בעלות של&nbsp;150&nbsp;ש\"ח לחודש </b>. לשם השוואה, מחירי התחזוקה <br>בשוק נעים בין 300-450 ש\"ח לחודש<br></p>\n                                </div>\n                                <div class=\"desc-wrap\" mbr-if=\"showDesc_1 || showDesc_2\">\n                                    <div class=\"item-desc\" mbr-if=\"showDesc_1\">\n                                        <p class=\"item-card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-card-desc\"><b>סוג אתר</b></p>\n                                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-desc\"><b>עד 3-4 דפים</b><br></p>\n                                    </div>\n                                    <div class=\"item-desc\" mbr-if=\"showDesc_2\">\n                                        <p class=\"item-card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-card-desc\"><b>\n                                            זמן הכנה\n                                        </b></p>\n                                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-desc\"><b>2-3 שבועות</b><br></p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"content-wrapper\">\n                                <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                    <h5 class=\"list-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".list-title\"><b>המחיר עלול להשתנות בהתאם לאתר</b></h5>\n                                    <div class=\"list-wrap\" mbr-if=\"showList\">\n                                        <div class=\"item-list\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 01\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\"><b>אורך הדפים:</b> אם דף מסוים יחשב כמו שני דפים מבחינת היקף העבודה, המחיר עלול להשתנות</p>\n                                        </div>\n                                        <div class=\"item-list\" mbr-if=\"list > 1\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 02\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\">\n                                                .<b>בקשות מיוחדות: </b>במידה והלקוח מבקש תוספות או שינויים מיוחדים, המחיר יתעדכן בהתאם\n                                            </p>\n                                        </div>\n                                        <div class=\"item-list\" mbr-if=\"list > 2\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 03\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\"><b>זמן הכנה:</b> זמן ההכנה של האתר משתנה בהתאם לדרישות. במידה והלקוח מעוניין להאיץ את תהליך ההכנה, עשוי להיות שינוי קל במחיר</p>\n                                        </div>\n                                        <div class=\"item-list\" mbr-if=\"list > 3\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 04\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\">\n                                                Family Size\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"price-wrapper\">\n                                    <div class=\"price-wrap\">\n                                      <div class=\"price-container\">\n                                                <p class=\"original-price\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price, .price-wrapper\"><b>2900-3500</b><br></p>\n                                                <p class=\"discount-price\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price, .price-wrapper\"><b>1800-2700</b></p>\n                                            </div>\n                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"index.html#form01-0\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>תשיארו פניה</a></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div><div class=\"item features-without-image item-mb\">\n                    <div class=\"subtitle-wrapper\" mbr-if=\"showSubtitle\">\n                        <div class=\"subtitle-wrap\">\n                            <div class=\"dot-wrap\"></div>\n                            <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .subtitle-wrapper\" mbr-theme-style=\"display-4\">בניית אתר עד 8 דפים</h3>\n                        </div>\n                    </div>\n                    <div class=\"item-wrapper\">\n                        <div class=\"card-box\">\n                            <div class=\"content-wrapper\">\n                                <div class=\"title-wrap\">\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>בניית אתר עד שמונה דפים</b></h4>\n                                    <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\"><b>אני מציע בניית אתר עד 8 דפים במחיר נע של&nbsp;2700-4500&nbsp;ש\"ח בלבד</b>. בשל המצב הנוכחי, המחיר שונה והוא תחרותי מאוד ביחס למחירים בשוק. בדרך כלל, בשוק נהוג לקחת על אתר עד 8 דפים מחיר הנע בין\n<br>6500-5000 ש\"ח\n<br>\n<br><b>?מה כלול במחיר\n<br></b>\n<br>.בניית האתר מותאמת אישית לצרכים שלך\n<br>.זמן ההכנה של האתר הוא בין 4-6 שבועות, תלוי בצרכים ובתיאום עם הלקוח\n<br>\n<br><b>תחזוקה שוטפת בעלות של 150 ש\"ח לחודש</b> . לשם השוואה, מחירי התחזוקה\n<br>בשוק נעים בין 400-580 ש\"ח לחודש<br></p>\n                                </div>\n                                <div class=\"desc-wrap\" mbr-if=\"showDesc_1 || showDesc_2\">\n                                    <div class=\"item-desc\" mbr-if=\"showDesc_1\">\n                                        <p class=\"item-card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-card-desc\"><b>סוג אתר</b></p>\n                                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-desc\"><b>עד 5-8 דפים</b></p>\n                                    </div>\n                                    <div class=\"item-desc\" mbr-if=\"showDesc_2\">\n                                        <p class=\"item-card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-card-desc\"><b>\n                                            זמן הכנה\n                                        </b></p>\n                                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-desc\"><b>&nbsp;שבועות 6 וחצי</b></p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"content-wrapper\">\n                                <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                    <h5 class=\"list-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".list-title\"><b>המחיר עלול להשתנות בהתאם לאתר</b></h5>\n                                    <div class=\"list-wrap\" mbr-if=\"showList\">\n                                        <div class=\"item-list\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 01\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\"><b>אורך הדפים:</b> אם דף מסוים יחשב כמו שני דפים מבחינת היקף העבודה, המחיר עלול להשתנות</p>\n                                        </div>\n                                        <div class=\"item-list\" mbr-if=\"list > 1\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 02\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\">.<b>בקשות מיוחדות:</b> במידה והלקוח מבקש תוספות או שינויים מיוחדים, המחיר יתעדכן בהתאם</p>\n                                        </div>\n                                        <div class=\"item-list\" mbr-if=\"list > 2\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 03\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\"><b>זמן הכנה:</b> זמן ההכנה של האתר משתנה בהתאם לדרישות. במידה והלקוח מעוניין להאיץ את תהליך ההכנה, עשוי להיות שינוי קל במחיר</p>\n                                        </div>\n                                        <div class=\"item-list\" mbr-if=\"list > 3\">\n                                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListNumber\" data-app-selector=\".card-number\">\n                                                / 04\n                                            </p>\n                                            <p class=\"list-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListDesc\" data-app-selector=\".list-desc\">אם ללקוח יש בקשות ספציות המחיר עלול להשתנות</p>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"price-wrapper\">\n                                    <div class=\"price-wrap\">\n                                      <div class=\"price-container\">\n                                                <p class=\"original-price\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price, .price-wrapper\"><b style>5000-6500</b></p>\n                                                <p class=\"discount-price\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price, .price-wrapper\"><b>2700-4500</b></p>\n                                            </div>\n                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"index.html#form01-0\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>תשיארו פניה</a></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
