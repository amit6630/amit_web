                    ".item-img": {
                      "margin-bottom": "32px",
                      "overflow": "hidden",
                      "border-radius": "10px",
                      "img": {
                        "height": "250px",
                        "object-fit": "cover",
                        "transition": "all 0.3s ease-in-out"
                      }
                    },
                    ".card-price": {
                      "margin-bottom": "22px"
                    },
                    ".card-title": {
                      "margin-bottom": "22px"
                    },
                    ".card-text": {
                      "margin-bottom": "22px"
                    }
                  }
                }
              }
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
