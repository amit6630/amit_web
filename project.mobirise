          "_name": "contacts01",
          "_sourceTheme": "politicsm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"contacts01 politicsm4_contacts01\" group=\"Contacts\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n\t\t<input type=\"range\" title=\"Icons Size\" name=\"iconsSize\" min=\"1\" max=\"9\" step=\"1\" value=\"7\" condition=\"showIcons\">\n\t\t<select title=\"Cards\" name=\"cardsAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t</select>\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n\t\t<header>Colors</header>\n\t\t<input type=\"color\" title=\"Line\" name=\"lineColor\" value=\"#000000\" selected condition=\"showTitle\">\n\t\t<input type=\"color\" title=\"Second Line\" name=\"lineColor2\" value=\"#00775c\" selected condition=\"showTitle\">\n\t\t<input type=\"color\" title=\"Cards Bg\" name=\"cardsBg\" value=\"#00775c\">\n\t\t<input type=\"color\" title=\"Second Cards Bg\" name=\"cardsBg1\" value=\"#131313\">\n\t\t<input type=\"color\" title=\"Icons\" name=\"iconsColor\" value=\"#00775c\" selected condition=\"showIcons\">\n\t\t<input type=\"color\" title=\"Second Icon\" name=\"iconsColor2\" value=\"#f9b03e\" selected condition=\"showIcons\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"../_images/background2.jpg\" parallax>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#e6e6e6\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center mbr-white\" mbr-cards=\"bootstrap\">\n\t\t\t<div class=\"card p-3 col-12 col-md-8 col-lg-4\" mbr-if=\"cardsAmount > 0\">\n\t\t\t\t<div class=\"card-wrapper card1 align-left\">\n\t\t\t\t\t<div class=\"card-ico pb-4\" mbr-if=\"showIcons\">\n\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont card-icon mobi-mbri-phone mobi-mbri\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-ico, .line-wrap\">תתקשרו</h4>\n\t\t\t\t\t\t<div class=\"line-wrap\" mbr-if=\"showTitle\">\n\t\t\t\t\t\t\t<div class=\"line\"></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .card-link\"><a href=\"tel:+972537155757\" class=\"text-info\"><b>053-715-5757</b></a></p>\n\t\t\t\t\t\t<div class=\"card-link pt-2\" mbr-if=\"showLink\">\n\t\t\t\t\t\t\t<a href=\"https://mobiri.se/\"><span mbr-icon class=\"mbr-iconfont link-ico mobi-mbri-arrow-next mobi-mbri\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card p-3 col-12 col-md-8 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n\t\t\t\t<div class=\"card-wrapper card2 align-left\">\n\t\t\t\t\t<div class=\"card-ico pb-4 align-left\" mbr-if=\"showIcons\">\n\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont card-icon icon2 mobi-mbri-map-pin mobi-mbri\" style=\"color: rgb(0, 119, 92); fill: rgb(0, 119, 92);\"></span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title1 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-ico, .line-wrap\"><b>מיקום</b></h4>\n\t\t\t\t\t\t<div class=\"line-wrap\" mbr-if=\"showTitle\">\n\t\t\t\t\t\t\t<div class=\"line line2\"></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"mbr-text1 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .card-link\"><b>בכל מקום</b></p>\n\t\t\t\t\t\t<div class=\"card-link pt-2\" mbr-if=\"showLink\">\n\t\t\t\t\t\t\t<a href=\"https://mobiri.se/\"><span mbr-icon class=\"mbr-iconfont link-ico link2  mobi-mbri-arrow-next mobi-mbri\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card p-3 col-12 col-md-8 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n\t\t\t\t<div class=\"card-wrapper card3 align-left\">\n\t\t\t\t\t<div class=\"card-ico pb-4 align-left\" mbr-if=\"showIcons\">\n\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont card-icon mobi-mbri-edit mobi-mbri\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-ico, .line-wrap\">תשאירו מייל</h4>\n\t\t\t\t\t\t<div class=\"line-wrap\" mbr-if=\"showTitle\">\n\t\t\t\t\t\t\t<div class=\"line\"></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .card-link\"><b>amitshechter6630@gmail.com</b><br></p>\n\t\t\t\t\t\t<div class=\"card-link pt-2\" mbr-if=\"showLink\">\n\t\t\t\t\t\t\t<a href=\"https://mobiri.se/\"><span mbr-icon class=\"mbr-iconfont link-ico mobi-mbri-arrow-next mobi-mbri\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
